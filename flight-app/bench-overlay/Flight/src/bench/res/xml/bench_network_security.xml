<?xml version="1.0" encoding="utf-8"?>
<!-- The test rig's build only: plain traffic to this phone's own loopback address, nowhere else (everything else
     keeps Android's default: none). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
