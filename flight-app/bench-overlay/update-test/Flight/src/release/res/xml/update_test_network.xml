<?xml version="1.0" encoding="utf-8"?>
<!-- The update test's builds only: plain traffic to the bench's own web server on the PC, as the emulator (10.0.2.2)
     and a real phone through adb reverse (127.0.0.1) reach it, nowhere else (everything else keeps Android's default:
     none). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
