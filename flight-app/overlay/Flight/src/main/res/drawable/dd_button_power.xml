<?xml version="1.0" encoding="utf-8"?>
<!-- DRAUPNE Link: STANDBY / DEEP SLEEP / WAKE - outlined in grey, quieter than LOCK SCREEN's yellow -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/dd_panel" />
            <stroke android:width="1dp" android:color="@color/dd_line" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/dd_line" />
            <stroke android:width="1dp" android:color="@color/dd_muted" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/dd_panel_2" />
            <stroke android:width="1dp" android:color="@color/dd_muted" />
        </shape>
    </item>
</selector>
